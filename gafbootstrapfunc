# Load the required library
library(MASS)

# Set the seed for reproducibility
set.seed(12321)

# Define parameters
dimension <- 3  # 3-dimensional sample
sample_size <- 27  # sample size
num_samples <- 15000  # number of covariance matrices

# Function to generate Wishart matrices manually
generate_wishart <- function(sample_size, dimension) {
  # Generate a sample from multivariate normal distribution
  sample_data <- mvrnorm(n = sample_size, mu = rep(0, dimension), Sigma = diag(dimension))
  
  # Calculate the Wishart matrix (sample covariance matrix)
  t(sample_data) %*% sample_data
}

# Generate 15,000 Wishart matrices and calculate sqrt(det) for each
wishart_sqrt_dets <- replicate(num_samples, {
  wishart_matrix <- generate_wishart(sample_size, dimension)
  sqrt(det(wishart_matrix))
})

# Calculate 6% symmetric two-tailed confidence interval
alpha <- 0.06
lower_boundary <- quantile(wishart_sqrt_dets, probs = alpha / 2)
upper_boundary <- quantile(wishart_sqrt_dets, probs = 1 - alpha / 2)

# Display the results
cat("Lower Boundary =", round(lower_boundary, 4), "\n")
cat("Upper Boundary =", round(upper_boundary, 4), "\n")


# Load the required library
library(MASS)

# Set the seed for reproducibility
set.seed(12321)

# Define parameters
dimension <- 3  # 3-dimensional sample
sample_size <- 27  # original sample size
num_samples <- 15000  # number of bootstrap samples

# Generate an initial multivariate normal dataset
original_data <- mvrnorm(n = sample_size, mu = rep(0, dimension), Sigma = diag(dimension))

# Bootstrap process
bootstrap_sqrt_dets <- replicate(num_samples, {
  # Resample rows of the original dataset with replacement
  resampled_data <- original_data[sample(1:sample_size, sample_size, replace = TRUE), ]
  
  # Calculate the covariance matrix for the resampled data
  covariance_matrix <- cov(resampled_data)
  
  # Compute the square root of the determinant of the covariance matrix
  sqrt(det(covariance_matrix))
})

# Calculate 6% symmetric two-tailed confidence interval
alpha <- 0.06
lower_boundary <- quantile(bootstrap_sqrt_dets, probs = alpha / 2)
upper_boundary <- quantile(bootstrap_sqrt_dets, probs = 1 - alpha / 2)

# Display the results
