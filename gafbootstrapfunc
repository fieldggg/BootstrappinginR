              Number.of.Loyalty.Program.Points + 
              Number.of.Ad.Clicks.per.Week + 
              Number.of.Ad.Impressions.per.Week, data = data)

# Function to calculate Wilks' Lambda test statistic
calculate_wilks <- function(fit_model) {
  residuals_matrix <- resid(fit_model)
  predicted_matrix <- fit_model$fitted.values
  
  # Compute residual sum of squares and total sum of squares
  E <- t(residuals_matrix) %*% residuals_matrix
  H <- t(predicted_matrix) %*% predicted_matrix
  
  # Compute Wilks' lambda
  eigen_values <- eigen(solve(E + H) %*% E)$values
  prod(eigen_values)
}

# Bootstrap to compute Wilks' statistic for 5,000 samples
bootstrap_samples <- 5000
bootstrap_wilks <- replicate(bootstrap_samples, {
  sample_indices <- sample(1:nrow(data), replace = TRUE)
  boot_model <- lm(cbind(Number.of.Online.Purchases.in.Last.Month, 
                         Average.Time.on.Social.Media.per.Day..min.) ~ 
                     Number.of.Loyalty.Program.Points + 
                     Number.of.Ad.Clicks.per.Week + 
                     Number.of.Ad.Impressions.per.Week, 
                   data = data[sample_indices, ])
  calculate_wilks(boot_model)
})

# 9% symmetric right-tailed confidence boundary
alpha <- 0.09
confidence_boundary <- quantile(bootstrap_wilks, probs = 1 - alpha)

# Display the result
cat("Confidence Boundary =", round(confidence_boundary, 4), "\n")



