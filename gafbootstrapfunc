# Load the necessary libraries
library(MASS)

# Set the seed for reproducibility
set.seed(12321)

# Define parameters
p <- 3  # Number of predictors
d <- 2  # Number of dependent variables
n <- 500  # Sample size
num_iterations <- 5000  # Number of Monte Carlo iterations

# Monte Carlo Simulation
hotelling_lowry_statistics <- replicate(num_iterations, {
  # Generate X matrix (predictors) with multivariate normal distribution
  X <- mvrnorm(n, mu = rep(0, p), Sigma = diag(p))
  
  # Generate true coefficients (Beta) matrix
  Beta <- matrix(rnorm(p * d), nrow = p, ncol = d)
  
  # Generate residuals matrix (multivariate normal)
  residuals <- mvrnorm(n, mu = rep(0, d), Sigma = diag(d))
  
  # Generate Y matrix (responses)
  Y <- X %*% Beta + residuals
  
  # Calculate Σ_X (covariance of predictors)
  Sigma_X <- cov(X)
  
  # Estimate Beta-hat
  Beta_hat <- solve(t(X) %*% X) %*% t(X) %*% Y
  
  # Calculate residual covariance matrix Σ_Y|X
  residuals_hat <- Y - X %*% Beta_hat
  Sigma_Y_given_X <- t(residuals_hat) %*% residuals_hat / (n - p)
  
  # Hotelling-Lowry test statistic: det(Σ_Y) / det(Σ_Y|X)
  det(cov(Y)) / det(Sigma_Y_given_X)
})

# Calculate the 8% symmetric two-tailed confidence interval
alpha <- 0.08
lower_critical_value <- quantile(hotelling_lowry_statistics, probs = alpha / 2)
upper_critical_value <- quantile(hotelling_lowry_statistics, probs = 1 - alpha / 2)

# Display the results
cat("Lower Critical Value =", round(lower_critical_value, 2), "\n")
cat("Upper Critical Value =", round(upper_critical_value, 2), "\n")

















