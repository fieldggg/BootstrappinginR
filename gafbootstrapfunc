# Load necessary libraries
library(MASS)
library(matrixsampling)

# Set the seed for reproducibility
set.seed(12321)

# Load the dataset
data <- read.csv("Audience_Advertising_10_24.csv")

# Filter Instagram users
instagram_data <- data[data$Preferred.Platform == "Instagram",]

# Extract Customer Lifetime Value
clv_instagram <- instagram_data$Customer.Lifetime.Value..USD.

# Bootstrap sampling
bootstrap_samples <- 20000
bootstrap_means <- replicate(bootstrap_samples, mean(sample(clv_instagram, replace = TRUE)))

# Calculate 7% symmetric two-tailed confidence interval
alpha <- 0.07
lower_boundary <- quantile(bootstrap_means, probs = alpha / 2)
upper_boundary <- quantile(bootstrap_means, probs = 1 - alpha / 2)

# Display results
cat("Lower Boundary =", round(lower_boundary, 2), "\n")
cat("Upper Boundary =", round(upper_boundary, 2), "\n")



# Load necessary libraries
library(MASS)

# Set the seed for reproducibility
set.seed(12321)

# Load your dataset
data <- read.csv("Audience_Advertising_10_24.csv")

# Simple linear regression: Number of Online Purchases ~ Number of Loyalty Program Points
model <- lm(Number.of.Online.Purchases.in.Last.Month ~ Number.of.Loyalty.Program.Points, data = data)

# Calculate residuals
residuals <- resid(model)

# Define function to calculate kurtosis
kurtosis <- function(x) {
  n <- length(x)
  mean((x - mean(x))^4) / (var(x)^2)
}

# Bootstrap to calculate kurtosis for residuals
bootstrap_samples <- 20000
bootstrap_kurtosis <- replicate(bootstrap_samples, {
  sample_residuals <- sample(residuals, replace = TRUE)
  kurtosis(sample_residuals)
})

# 12% symmetric two-tailed confidence interval
alpha <- 0.12
lower_boundary <- quantile(bootstrap_kurtosis, probs = alpha / 2)
upper_boundary <- quantile(bootstrap_kurtosis, probs = 1 - alpha / 2)

# Display results
cat("Lower Boundary =", round(lower_boundary, 2), "\n")
cat("Upper Boundary =", round(upper_boundary, 2), "\n")


