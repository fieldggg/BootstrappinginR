# Load necessary package
install.packages("mvtnorm")
library(mvtnorm)

# Define the mean vector and covariance matrix from the dataset mydata
mean_vec <- colMeans(mydata[,c("Thiamin_mg", "Niacin_mg", "Ascorbic_Acid_mg")])
cov_matrix <- cov(mydata[,c("Thiamin_mg", "Niacin_mg", "Ascorbic_Acid_mg")])

# Set the minimum and maximum boundaries for the Type 1 healthy profile
lower_bounds <- c(10, 14, 118)  # Minimum intake for Vitamins B1, B3, and C
upper_bounds <- c(13, 15, 124)  # Maximum intake for Vitamins B1, B3, and C

# Calculate the probability that a randomly selected individual has a Type 1 healthy profile
probability <- pmvnorm(lower = lower_bounds, upper = upper_bounds, mean = mean_vec, sigma = cov_matrix)
probability
# Display the result
cat("The probability of having a Type 1 healthy profile is:", round(probability, 4))




# Calculate Z-scores for each vitamin

