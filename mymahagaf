mymaha = function (X, mu, sighat){
  n = dim(X)[1]
  d = dim(X)[2]
  
  dm = c()
  
  siginv = solve(sighat) #inverse of cov matrix
  for(k in 1:n){
    myx = X[k,]#all columns
    dm = c(dm, sqrt(t(myx-mu)%*%siginv%*%(myx-mu)))
  }
  return(dm)
}












