z2_thiamin <- (13 - mean_thiamin) / sd_thiamin
p_thiamin <- pnorm(z2_thiamin) - pnorm(z1_thiamin)

# For Vitamin B3 (Niacin)
mean_niacin <- mean(mydata$Niacin_mg)
sd_niacin <- sd(mydata$Niacin_mg)
z1_niacin <- (14 - mean_niacin) / sd_niacin
z2_niacin <- (15 - mean_niacin) / sd_niacin
p_niacin <- pnorm(z2_niacin) - pnorm(z1_niacin)

# For Vitamin C (Ascorbic Acid)
